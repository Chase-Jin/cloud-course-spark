# 华为云区域，例如 cn-east-3 或 cn-north-4
REGION=cn-north-4

# SWR 组织名，建议包含学号
ORG=cloud-course-2026

# 个人信息，用于前端首页验收
STUDENT_ID=2023114956_2023112592
STUDENT_NAME=金井直_赵祺

# Redis 密码，部署 K8s Secret 前需要 base64 编码
REDIS_PASSWORD=CloudCourse@123

# 教师提供或你自己构建的 PySpark 基础镜像
SPARK_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/cloud-course-2026/pyspark:3.4

# OBS 配置。AK/SK 不要提交到公开仓库。
OBS_BUCKET=cloud-course-2026-bucket
OBS_ENDPOINT=obs.cn-north-4.myhuaweicloud.com
DOUBAN_INPUT_PATH=s3a://cloud-course-2026-bucket/datasets/douban_movies.csv
WORDCOUNT_INPUT_PATH=s3a://cloud-course-2026-bucket/sample.txt
SPARK_OUTPUT_PATH=s3a://cloud-course-2026-bucket/output/douban-analysis
